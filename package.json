{
  "name": "deeb-field-operations",
  "version": "10.0.3",
  "private": true,
  "description": "DEEB field operations PWA prepared for Capacitor Android packaging",
  "scripts": {
    "test": "node static-smoke-test.js && node db-integration-test.js",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "build:biometric": "esbuild biometric-entry.js --bundle --format=iife --outfile=www/biometric.bundle.js",
    "prepare:android": "node prepare-android.js",
    "configure:android:share": "node configure-android-share.js",
    "build:native-plugins": "esbuild native-plugins-entry.js --bundle --format=iife --outfile=www/native-plugins.bundle.js"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "9.1.2",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.4"
  }
}
